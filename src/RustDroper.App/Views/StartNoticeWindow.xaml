<Window x:Class="RustDroper.App.Views.StartNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RustDroper.App.Views"
        Title="Rust Droper" Width="460" SizeToContent="Height" ResizeMode="NoResize" WindowStyle="None" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="Transparent" AllowsTransparency="True" FontFamily="Segoe UI" FontSize="13"
        Foreground="{StaticResource TextBrush}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid x:Name="Root" Margin="16" RenderTransformOrigin="0.5,0.5" Opacity="0">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="Pop" ScaleX="0.95" ScaleY="0.95" />
        </Grid.RenderTransform>
        <views:StartNoticeView x:Name="NoticeView" />
    </Grid>
</Window>
