<UserControl x:Class="RustDroper.App.Views.StartNoticeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RustDroper.App.Views"
             xmlns:vm="clr-namespace:RustDroper.App.ViewModels"
             xmlns:loc="clr-namespace:RustDroper.App.Localization">
    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="24,22,24,20">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Border Width="38" Height="38" CornerRadius="19" Background="#26E5A93D" VerticalAlignment="Center">
                    <views:Icon Data="{StaticResource IconAlert}" Foreground="{StaticResource WarnBrush}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{x:Static vm:StartNoticeText.Title}" FontSize="17" FontWeight="SemiBold" Margin="14,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{x:Static vm:StartNoticeText.Message}" TextWrapping="Wrap" Margin="0,16,0,0" FontSize="13.5" LineHeight="20"
                       AutomationProperties.AutomationId="StartNoticeMessage" />
            <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="DontShowAgain" Content="{loc:Loc startNotice.dontShow}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                          AutomationProperties.AutomationId="DontShowAgain" />
                <Button x:Name="OkButton" Grid.Column="1" Content="{loc:Loc startNotice.ok}" Style="{StaticResource PrimaryButton}" MinWidth="96" IsDefault="True"
                        AutomationProperties.AutomationId="StartNoticeOk" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
