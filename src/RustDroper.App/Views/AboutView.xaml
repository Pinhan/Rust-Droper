<UserControl x:Class="RustDroper.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RustDroper.App.Views"
             xmlns:loc="clr-namespace:RustDroper.App.Localization">
    <StackPanel>
        <Grid Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <views:Icon Style="{StaticResource SectionIcon}" Data="{StaticResource IconInfo}" />
                <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Loc about.title}" />
            </StackPanel>
            <Button Command="{Binding DataContext.ToggleAboutCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource GhostButton}"
                    HorizontalAlignment="Right" Padding="12,5" AutomationProperties.AutomationId="AboutBackButton">
                <StackPanel Orientation="Horizontal">
                    <views:Icon Style="{StaticResource BtnIcon}" Data="{StaticResource IconBack}" Width="14" Height="14" />
                    <TextBlock Text="{loc:Loc about.back}" />
                </StackPanel>
            </Button>
        </Grid>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource AccentBrush}" VerticalAlignment="Center">
                        <views:Icon Data="{StaticResource IconDrop}" IsFilled="True" Width="22" Height="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource Muted}" AutomationProperties.AutomationId="AboutVersion" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="{Binding Tagline}" Margin="0,12,0,0" TextWrapping="Wrap" />

                <TextBlock Text="{Binding Developer}" Margin="0,16,0,0" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="{loc:Loc about.contactLabel}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="thepinhan@gmail.com" VerticalAlignment="Center" FontWeight="SemiBold" AutomationProperties.AutomationId="AboutEmail" />
                    <Button Command="{Binding MailCommand}" Style="{StaticResource GhostButton}" Margin="12,0,0,0" Padding="10,4" AutomationProperties.AutomationId="AboutMailButton">
                        <StackPanel Orientation="Horizontal">
                            <views:Icon Style="{StaticResource BtnIcon}" Data="{StaticResource IconExternal}" Width="13" Height="13" />
                            <TextBlock Text="{loc:Loc about.sendMail}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CopyMailCommand}" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Padding="10,4" AutomationProperties.AutomationId="AboutCopyMailButton">
                        <StackPanel Orientation="Horizontal">
                            <views:Icon Style="{StaticResource BtnIcon}" Data="{StaticResource IconCopy}" Width="13" Height="13" />
                            <TextBlock Text="{loc:Loc about.copy}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock Text="{Binding Copied}" Style="{StaticResource Muted}" Foreground="{StaticResource OkBrush}" Margin="0,4,0,0"
                           Visibility="{Binding Copied, Converter={StaticResource PresentToVis}}" />
                <TextBlock Text="{loc:Loc about.feedback}"
                           Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" />

                <TextBlock Text="{loc:Loc about.whatTitle}" FontWeight="SemiBold" Margin="0,18,0,4" />
                <TextBlock Text="{Binding WhatItDoes}" Style="{StaticResource Muted}" TextWrapping="Wrap" />

                <TextBlock Text="{loc:Loc about.privacyTitle}" FontWeight="SemiBold" Margin="0,16,0,4" />
                <TextBlock Text="{Binding Privacy}" Style="{StaticResource Muted}" TextWrapping="Wrap" />

                <TextBlock Text="{loc:Loc about.noteTitle}" FontWeight="SemiBold" Margin="0,16,0,4" />
                <TextBlock Text="{Binding Disclaimer}" Style="{StaticResource Muted}" TextWrapping="Wrap" />

                <TextBlock Text="{loc:Loc about.componentsTitle}" FontWeight="SemiBold" Margin="0,16,0,4" />
                <ItemsControl ItemsSource="{Binding ThirdParty}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource Muted}" Margin="0,1" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Command="{Binding OpenDataFolderCommand}" Style="{StaticResource GhostButton}" Padding="10,5" AutomationProperties.AutomationId="AboutOpenData">
                        <TextBlock Text="{loc:Loc about.openData}" />
                    </Button>
                    <Button Command="{Binding OpenLogsFolderCommand}" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Padding="10,5" AutomationProperties.AutomationId="AboutOpenLogs">
                        <TextBlock Text="{loc:Loc about.openLogs}" />
                    </Button>
                </StackPanel>
                <TextBlock Text="{Binding Copyright}" Style="{StaticResource Muted}" Margin="0,16,0,0" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
