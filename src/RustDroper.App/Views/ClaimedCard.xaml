<UserControl x:Class="RustDroper.App.Views.ClaimedCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RustDroper.App.Views">
    <UserControl.Triggers>
        <!-- Üzerine gelince görsel hafifçe yakınlaşır (kısa, tek seferlik) -->
        <EventTrigger RoutedEvent="MouseEnter">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                    <DoubleAnimation Storyboard.TargetName="Zoom" Storyboard.TargetProperty="ScaleX" To="1.09" Duration="0:0:0.35">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="Zoom" Storyboard.TargetProperty="ScaleY" To="1.09" Duration="0:0:0.35">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
        <EventTrigger RoutedEvent="MouseLeave">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.62" Duration="0:0:0.25" />
                    <DoubleAnimation Storyboard.TargetName="Zoom" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.25" />
                    <DoubleAnimation Storyboard.TargetName="Zoom" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.25" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid x:Name="Root" Margin="0,0,10,10" Opacity="0.62">
        <Border CornerRadius="10" Background="{StaticResource PanelBrush}" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="#664CC38A" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource OkBrush}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <!-- Görsel alanı (yatay oran 5:4) -->
                <Grid Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource ScaleConverter}, ConverterParameter=0.8}">
                    <Border CornerRadius="9,9,0,0" Background="{StaticResource TrackBrush}" />
                    <views:Icon Data="{StaticResource IconAward}" Foreground="{StaticResource BorderBrush}" Width="30" Height="30" StrokeThickness="1.5"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding HasImage, Converter={StaticResource InvBoolToVis}}" />
                    <Border CornerRadius="9,9,0,0" Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding ImagePath, Converter={StaticResource PathToImage}}" Stretch="UniformToFill">
                                <ImageBrush.RelativeTransform>
                                    <ScaleTransform x:Name="Zoom" CenterX="0.5" CenterY="0.5" ScaleX="1" ScaleY="1" />
                                </ImageBrush.RelativeTransform>
                            </ImageBrush>
                        </Border.Background>
                    </Border>
                    <!-- Gri ton: görseli soluklaştıran yarı saydam kaplama (hover'da kalkar) -->
                    <Border CornerRadius="9,9,0,0" Background="#7A2A2D33" IsHitTestVisible="False"
                            Visibility="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InvBoolToVis}}" />
                    <!-- Claim edildi: tik rozeti -->
                    <Border Width="24" Height="24" CornerRadius="12" Background="#D914161A" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0">
                        <views:Icon Data="{StaticResource IconCheck}" Foreground="{StaticResource OkBrush}" StrokeThickness="2.6" Width="13" Height="13"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
                <StackPanel Margin="10,8,10,10">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" ToolTip="{Binding Name}" />
                    <TextBlock Text="{Binding SourceText}" Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding DetailText}" Style="{StaticResource Muted}" FontSize="11" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding DetailText, Converter={StaticResource PresentToVis}}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
