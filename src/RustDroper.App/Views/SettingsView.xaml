<UserControl x:Class="RustDroper.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RustDroper.App.Views"
             xmlns:loc="clr-namespace:RustDroper.App.Localization">
    <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <views:Icon Style="{StaticResource SectionIcon}" Data="{StaticResource IconSliders}" />
            <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Loc settings.title}" />
        </StackPanel>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <CheckBox IsChecked="{Binding StartWithWindows, Mode=TwoWay}" Content="{loc:Loc settings.startWithWindows}" />
                <TextBlock Style="{StaticResource Muted}" Margin="50,3,0,14"
                           Text="{loc:Loc settings.startWithWindows.hint}" />

                <CheckBox IsChecked="{Binding StartMinimized, Mode=TwoWay}" Content="{loc:Loc settings.startMinimized}" />
                <TextBlock Style="{StaticResource Muted}" Margin="50,3,0,14"
                           Text="{loc:Loc settings.startMinimized.hint}" />

                <CheckBox IsChecked="{Binding AutoClaim, Mode=TwoWay}" Content="{loc:Loc settings.autoClaim}" />
                <TextBlock Style="{StaticResource Muted}" Margin="50,3,0,14" TextWrapping="Wrap"
                           Text="{loc:Loc settings.autoClaim.hint}" />

                <CheckBox IsChecked="{Binding KeepAwake, Mode=TwoWay}" Content="{loc:Loc settings.keepAwake}" />
                <TextBlock Style="{StaticResource Muted}" Margin="50,3,0,14" TextWrapping="Wrap"
                           Text="{loc:Loc settings.keepAwake.hint}" />

                <CheckBox IsChecked="{Binding RustRewardsOnly, Mode=TwoWay}" Content="{loc:Loc settings.rustOnly}" />
                <TextBlock Style="{StaticResource Muted}" Margin="50,3,0,14" TextWrapping="Wrap"
                           Text="{loc:Loc settings.rustOnly.hint}" />

                <CheckBox IsChecked="{Binding AutoRestart, Mode=TwoWay}" Content="{loc:Loc settings.autoRestart}" />
                <TextBlock Style="{StaticResource Muted}" Margin="50,3,0,14" TextWrapping="Wrap"
                           Text="{loc:Loc settings.autoRestart.hint}" />

                <CheckBox IsChecked="{Binding ShowStartNotice, Mode=TwoWay}" Content="{loc:Loc settings.startNotice}" />
                <TextBlock Style="{StaticResource Muted}" Margin="50,3,0,14" TextWrapping="Wrap"
                           Text="{loc:Loc settings.startNotice.hint}" />

                <CheckBox IsChecked="{Binding Notifications, Mode=TwoWay}" Content="{loc:Loc settings.notifications}" />
                <TextBlock Style="{StaticResource Muted}" Margin="50,3,0,8" TextWrapping="Wrap"
                           Text="{loc:Loc settings.notifications.hint}" />
                <Button Content="{loc:Loc settings.testNotification}" Command="{Binding TestNotificationCommand}" HorizontalAlignment="Left" Margin="50,0,0,14" Padding="12,5"
                        AutomationProperties.AutomationId="TestNotificationButton" />

                <TextBlock Text="{loc:Loc settings.language}" Margin="0,0,0,6" />
                <ItemsControl ItemsSource="{Binding LanguageOptions}" AutomationProperties.AutomationId="LanguageChoices">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource ChoiceButton}" GroupName="UiLanguage" Content="{Binding Label}"
                                         IsChecked="{Binding IsSelected, Mode=TwoWay}" AutomationProperties.Name="{Binding Label}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Foreground="{StaticResource WarnBrush}" Margin="0,12,0,0" TextWrapping="Wrap"
                           Text="{Binding Error}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
