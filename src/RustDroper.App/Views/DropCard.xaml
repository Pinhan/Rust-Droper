<UserControl x:Class="RustDroper.App.Views.DropCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RustDroper.App.Views"
             xmlns:vm="clr-namespace:RustDroper.App.ViewModels"
             xmlns:loc="clr-namespace:RustDroper.App.Localization">
    <UserControl.Resources>
        <Style x:Key="BadgeGlyph" TargetType="views:Icon" BasedOn="{StaticResource {x:Type views:Icon}}">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <UserControl.Triggers>
        <!-- Üzerine gelince görsel hafifçe yakınlaşır (kısa, tek seferlik; sürekli animasyon yok) -->
        <EventTrigger RoutedEvent="MouseEnter">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Zoom" Storyboard.TargetProperty="ScaleX" To="1.09" Duration="0:0:0.35">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="Zoom" Storyboard.TargetProperty="ScaleY" To="1.09" Duration="0:0:0.35">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
        <EventTrigger RoutedEvent="MouseLeave">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Zoom" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.25" />
                    <DoubleAnimation Storyboard.TargetName="Zoom" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.25" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid Margin="0,0,10,10">
        <!-- Claim'e hazır: hafif parıltı (efekt yok; yarı saydam kalın çerçeve) -->
        <Border Margin="-3" CornerRadius="13" BorderThickness="3" BorderBrush="#40E5A93D" IsHitTestVisible="False"
                Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter=ClaimReady}" />
        <Border x:Name="Card" CornerRadius="10" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource MutedBrush}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding State}" Value="{x:Static vm:DropState.Watching}">
                            <Setter Property="BorderBrush" Value="{DynamicResource PlatformAccentBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="{x:Static vm:DropState.ClaimReady}">
                            <Setter Property="BorderBrush" Value="{StaticResource WarnBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="{x:Static vm:DropState.Claimed}">
                            <Setter Property="BorderBrush" Value="#664CC38A" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <!-- Görsel alanı (kare) -->
                <Grid Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}">
                    <Border CornerRadius="9,9,0,0" Background="{StaticResource TrackBrush}" />
                    <!-- Yer tutucu ikon (görsel yokken) -->
                    <views:Icon Data="{StaticResource IconGift}" Foreground="{StaticResource BorderBrush}" Width="38" Height="38" StrokeThickness="1.5"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding HasImage, Converter={StaticResource InvBoolToVis}}" />
                    <Border CornerRadius="9,9,0,0" Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding ImagePath, Converter={StaticResource PathToImage}}" Stretch="UniformToFill">
                                <ImageBrush.RelativeTransform>
                                    <ScaleTransform x:Name="Zoom" CenterX="0.5" CenterY="0.5" ScaleX="1" ScaleY="1" />
                                </ImageBrush.RelativeTransform>
                            </ImageBrush>
                        </Border.Background>
                    </Border>
                    <!-- Sırada/kilitli ve etkinlik beklenirken soluk -->
                    <Border CornerRadius="9,9,0,0" Background="#8C14161A" IsHitTestVisible="False"
                            Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter='Queued,Waiting,Ended'}" />
                    <!-- Alt kenar: degrade + ilerleme çubuğu (yerleşik) -->
                    <Border VerticalAlignment="Bottom" Height="34" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0" />
                                <GradientStop Color="#B3000000" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <ProgressBar VerticalAlignment="Bottom" Height="5" Margin="9,0,9,8" views:Motion.AnimatedValue="{Binding Percent, Mode=OneWay}">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="{x:Static vm:DropState.Claimed}">
                                        <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="{x:Static vm:DropState.ClaimReady}">
                                        <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                    <!-- Durum ikonu (sol üst) -->
                    <Border Width="26" Height="26" CornerRadius="13" Background="#D914161A" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0"
                            AutomationProperties.AutomationId="DropStateBadge">
                        <Grid>
                            <views:Icon Style="{StaticResource BadgeGlyph}" Data="{StaticResource IconLock}" Foreground="{StaticResource MutedBrush}"
                                        Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter=Queued}" />
                            <views:Icon Style="{StaticResource BadgeGlyph}" Data="{StaticResource IconClock}" Foreground="{StaticResource MutedBrush}"
                                        Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter='Waiting,Ended'}" />
                            <views:Icon Style="{StaticResource BadgeGlyph}" Data="{StaticResource IconClock}" Foreground="{StaticResource InfoBrush}"
                                        Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter=InProgress}" />
                            <Ellipse Width="10" Height="10" Fill="{StaticResource OkBrush}" Style="{StaticResource PulseDot}"
                                     Tag="{Binding State, Converter={StaticResource StateIs}, ConverterParameter=Watching}"
                                     Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter=Watching}" />
                            <views:Icon Style="{StaticResource BadgeGlyph}" Data="{StaticResource IconGift}" Foreground="{StaticResource WarnBrush}" Width="15" Height="15"
                                        Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter=ClaimReady}" />
                            <views:Icon Style="{StaticResource BadgeGlyph}" Data="{StaticResource IconCheck}" Foreground="{StaticResource OkBrush}" StrokeThickness="2.6"
                                        Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter=Claimed}" />
                        </Grid>
                    </Border>
                    <!-- Sürükleme tutamacı (yalnız yayıncı kartları): öncelik sırasını değiştirmek için tutup sürükle -->
                    <Border views:CardDrag.IsHandle="True" Width="26" Height="18" CornerRadius="9" Background="#D914161A" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0"
                            Cursor="SizeAll" ToolTip="{loc:Loc dropcard.drag.tip}" AutomationProperties.AutomationId="DragHandle"
                            Visibility="{Binding IsDraggable, Converter={StaticResource BoolToVis}}">
                        <UniformGrid Columns="2" Rows="3" Width="8" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <Ellipse Width="2.4" Height="2.4" Fill="{StaticResource MutedBrush}" />
                            <Ellipse Width="2.4" Height="2.4" Fill="{StaticResource MutedBrush}" />
                            <Ellipse Width="2.4" Height="2.4" Fill="{StaticResource MutedBrush}" />
                            <Ellipse Width="2.4" Height="2.4" Fill="{StaticResource MutedBrush}" />
                            <Ellipse Width="2.4" Height="2.4" Fill="{StaticResource MutedBrush}" />
                            <Ellipse Width="2.4" Height="2.4" Fill="{StaticResource MutedBrush}" />
                        </UniformGrid>
                    </Border>
                    <!-- Yüzde (sağ üst) -->
                    <Border CornerRadius="9" Padding="7,2" Background="#D914161A" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"
                            Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter='InProgress,Watching,ClaimReady'}">
                        <TextBlock Text="{Binding PercentText}" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                </Grid>
                <!-- Alt satır: ad · süre, durum, kalan -->
                <StackPanel Margin="10,8,10,10">
                    <TextBlock TextWrapping="Wrap" ToolTip="{Binding Name}">
                        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " Foreground="{StaticResource MutedBrush}" /><Run Text="{Binding DurationText, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
                    </TextBlock>
                    <TextBlock Text="{Binding StateText}" FontSize="11" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                               Foreground="{Binding StateSeverity, Converter={StaticResource SeverityBrush}}" />
                    <TextBlock Text="{Binding RemainingText}" Style="{StaticResource Muted}" FontSize="11" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                    <!-- Yayıncı drop'u: yayıncı adı + CANLI noktası + kanal bağlantısı -->
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0" Visibility="{Binding HasStreamer, Converter={StaticResource BoolToVis}}">
                        <Ellipse Width="7" Height="7" Margin="0,1,6,0" VerticalAlignment="Center" Fill="{StaticResource ErrorBrush}"
                                 Visibility="{Binding StreamerLive, Converter={StaticResource BoolToVis}}" />
                        <TextBlock FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="120">
                            <Hyperlink Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=views:DashboardView}}"
                                       CommandParameter="{Binding StreamerUrl}"><Run Text="{Binding StreamerName, Mode=OneWay}" /> ↗</Hyperlink>
                        </TextBlock>
                        <TextBlock Text="{loc:Loc dropcard.live}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource ErrorBrush}" Margin="6,2,0,0"
                                   Visibility="{Binding StreamerLive, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
