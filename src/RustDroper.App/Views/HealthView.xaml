<UserControl x:Class="RustDroper.App.Views.HealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RustDroper.App.Views"
             xmlns:vm="clr-namespace:RustDroper.App.ViewModels"
             xmlns:loc="clr-namespace:RustDroper.App.Localization">
    <StackPanel>
        <Grid Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <views:Icon Style="{StaticResource SectionIcon}" Data="{StaticResource IconActivity}" />
                <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Loc health.title}" />
                <TextBlock Text="{Binding HealthSummary}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"
                           AutomationProperties.AutomationId="HealthSummary" />
            </StackPanel>
            <Button Command="{Binding CheckHealthCommand}" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Padding="12,5"
                    AutomationProperties.AutomationId="HealthRecheckButton" ToolTip="{loc:Loc health.recheck.tip}">
                <StackPanel Orientation="Horizontal">
                    <views:Icon Style="{StaticResource BtnIcon}" Data="{StaticResource IconRefresh}" Width="14" Height="14" />
                    <TextBlock Text="{loc:Loc health.recheck}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
        <Border Style="{StaticResource Card}">
            <ItemsControl ItemsSource="{Binding HealthItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:HealthItem}">
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="10" Height="10" VerticalAlignment="Top" Margin="0,5,0,0" HorizontalAlignment="Left">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource MutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Level}" Value="Ok">
                                                <Setter Property="Fill" Value="{StaticResource OkBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="Warn">
                                                <Setter Property="Fill" Value="{StaticResource WarnBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="Fail">
                                                <Setter Property="Fill" Value="{StaticResource ErrorBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Top" />
                            <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Top" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </StackPanel>
</UserControl>
