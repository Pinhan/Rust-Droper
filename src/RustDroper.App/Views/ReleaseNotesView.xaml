<UserControl x:Class="RustDroper.App.Views.ReleaseNotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RustDroper.App.Views"
             xmlns:loc="clr-namespace:RustDroper.App.Localization">
    <UserControl.Resources>
        <!-- Madde işaretli satır (bölüm maddeleri) -->
        <DataTemplate x:Key="BulletTemplate">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="•" Style="{StaticResource Muted}" HorizontalAlignment="Left" />
                <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel>
        <!-- Başlık satırı: ikon + başlık, sağda "Pano" -->
        <Grid Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <views:Icon Style="{StaticResource SectionIcon}" Data="{StaticResource IconHistory}" />
                <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Loc relnotes.title}" />
            </StackPanel>
            <Button Command="{Binding DataContext.ToggleReleaseNotesCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource GhostButton}"
                    HorizontalAlignment="Right" Padding="12,5" AutomationProperties.AutomationId="ReleaseNotesBackButton">
                <StackPanel Orientation="Horizontal">
                    <views:Icon Style="{StaticResource BtnIcon}" Data="{StaticResource IconBack}" Width="14" Height="14" />
                    <TextBlock Text="{loc:Loc relnotes.back}" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Semantic Versioning açıklaması -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,18" AutomationProperties.AutomationId="SemVerCard">
            <StackPanel>
                <TextBlock Text="{loc:Loc relnotes.semver.title}" FontWeight="SemiBold" FontSize="15" />
                <TextBlock Text="{loc:Loc relnotes.semver.intro}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                <UniformGrid Columns="3" Margin="-5,12,-5,0">
                    <Border Background="{StaticResource TrackBrush}" CornerRadius="8" Padding="14,12" Margin="5,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border CornerRadius="9" Padding="9,1" Background="#26E5604D">
                                    <TextBlock Text="{loc:Loc relnotes.type.major}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}" />
                                </Border>
                                <TextBlock Text="{loc:Loc relnotes.major.pattern}" FontFamily="Consolas" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{loc:Loc relnotes.major.desc}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource TrackBrush}" CornerRadius="8" Padding="14,12" Margin="5,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border CornerRadius="9" Padding="9,1" Background="#264CC38A">
                                    <TextBlock Text="{loc:Loc relnotes.type.minor}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource OkBrush}" />
                                </Border>
                                <TextBlock Text="{loc:Loc relnotes.minor.pattern}" FontFamily="Consolas" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{loc:Loc relnotes.minor.desc}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource TrackBrush}" CornerRadius="8" Padding="14,12" Margin="5,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border CornerRadius="9" Padding="9,1" Background="#26E5A93D">
                                    <TextBlock Text="{loc:Loc relnotes.type.patch}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource WarnBrush}" />
                                </Border>
                                <TextBlock Text="{loc:Loc relnotes.patch.pattern}" FontFamily="Consolas" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{loc:Loc relnotes.patch.desc}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- Sürüm kartları (yeni → eski): solda dikey zaman çizgisi + nokta -->
        <ItemsControl ItemsSource="{Binding Releases}" Focusable="False" AutomationProperties.AutomationId="ReleaseList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid AutomationProperties.AutomationId="ReleaseCard">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Rectangle Width="2" Fill="{StaticResource BorderBrush}" HorizontalAlignment="Center" Margin="0,26,0,0"
                                       Visibility="{Binding IsLast, Converter={StaticResource InvBoolToVis}}" />
                            <Ellipse Width="12" Height="12" VerticalAlignment="Top" Margin="0,20,0,0" HorizontalAlignment="Center"
                                     Fill="{Binding TypeSeverity, Converter={StaticResource SeverityBrush}}"
                                     Stroke="{StaticResource BgBrush}" StrokeThickness="3" />
                        </Grid>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding VersionText}" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center"
                                               AutomationProperties.AutomationId="ReleaseVersion" />
                                    <Border Grid.Column="1" CornerRadius="10" Padding="10,2" Margin="12,0,0,0" VerticalAlignment="Center" Background="{StaticResource TrackBrush}"
                                            BorderThickness="1" BorderBrush="{Binding TypeSeverity, Converter={StaticResource SeverityBrush}}">
                                        <TextBlock Text="{Binding TypeText}" FontSize="11" FontWeight="Bold" Foreground="{Binding TypeSeverity, Converter={StaticResource SeverityBrush}}" />
                                    </Border>
                                    <Border Grid.Column="2" CornerRadius="10" Padding="10,2" Margin="8,0,0,0" VerticalAlignment="Center" Background="{StaticResource PanelAltBrush}"
                                            Visibility="{Binding TagText, Converter={StaticResource PresentToVis}}">
                                        <TextBlock Text="{Binding TagText}" FontSize="11" />
                                    </Border>
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border CornerRadius="10" Padding="10,2" Margin="0,0,10,0" Background="{StaticResource TrackBrush}"
                                                Visibility="{Binding FromText, Converter={StaticResource PresentToVis}}">
                                            <TextBlock Text="{Binding FromText}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                        </Border>
                                        <TextBlock Text="{Binding DateText}" Style="{StaticResource Muted}" VerticalAlignment="Center" AutomationProperties.AutomationId="ReleaseDate" />
                                    </StackPanel>
                                </Grid>

                                <Border Background="{StaticResource TrackBrush}" CornerRadius="8" Padding="14,10" Margin="0,12,0,0"
                                        Visibility="{Binding SummaryText, Converter={StaticResource PresentToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc relnotes.summary}" FontSize="11" FontWeight="SemiBold" Style="{StaticResource Muted}" />
                                        <TextBlock Text="{Binding SummaryText}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>

                                <ItemsControl ItemsSource="{Binding Sections}" Focusable="False" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,12,0,0" AutomationProperties.AutomationId="ReleaseSection">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <views:Icon Data="{Binding IconKey, Converter={StaticResource GeometryKey}}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                                                                Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"
                                                               Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                                </StackPanel>
                                                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource BulletTemplate}" Focusable="False" Margin="24,0,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="{loc:Loc relnotes.empty}" Style="{StaticResource Muted}" Margin="2,0,0,0"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
    </StackPanel>
</UserControl>
