<UserControl x:Class="RustDroper.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RustDroper.App.Views"
             xmlns:loc="clr-namespace:RustDroper.App.Localization">
    <UserControl.Resources>
        <!-- Kampanya: başlık satırı + 5 sütunluk drop kartı ızgarası (genel ve yayıncı drop'ları AYNI kartı kullanır) -->
        <DataTemplate x:Key="CampaignTemplate">
            <StackPanel Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" FontSize="14" Margin="0,0,10,0"
                                   Visibility="{Binding Name, Converter={StaticResource PresentToVis}}" />
                        <TextBlock Text="{Binding StatusText, Mode=OneWay}" Foreground="{Binding StatusSeverity, Converter={StaticResource SeverityBrush}}" Margin="0,2,0,0" FontSize="12" />
                        <StackPanel Orientation="Horizontal" Margin="10,3,0,0" Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource OkBrush}" Margin="0,1,5,0" VerticalAlignment="Center" Tag="True" Style="{StaticResource PulseDot}" />
                            <TextBlock Text="{loc:Loc dash.watching}" Foreground="{StaticResource OkBrush}" FontSize="11" FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding TimeText, Mode=OneWay}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,3,0,10">
                    <TextBlock Text="{Binding SummaryText, Mode=OneWay}" Style="{StaticResource Muted}" />
                    <TextBlock Text="{Binding WatchableText, Mode=OneWay}" Style="{StaticResource Muted}" Margin="12,0,0,0"
                               Visibility="{Binding WatchableText, Converter={StaticResource PresentToVis}}" />
                </StackPanel>
                <!-- Kart sağ kenar boşluğu (10) telafi edilir -->
                <ItemsControl ItemsSource="{Binding Drops}" Margin="0,0,-10,0" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="5" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:DropCard AutomationProperties.AutomationId="DropCard" AutomationProperties.Name="{Binding Name}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <!-- ŞU AN -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <views:Icon Style="{StaticResource SectionIcon}" Data="{StaticResource IconActivity}" />
            <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Loc dash.nowTitle}" />
        </StackPanel>
        <Border Style="{StaticResource Card}" DataContext="{Binding Now}" Margin="0,0,0,18">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border CornerRadius="11" Padding="11,3" Background="{StaticResource TrackBrush}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,2,7,0" VerticalAlignment="Center" Style="{StaticResource PulseDot}"
                                     Fill="{Binding BadgeSeverity, Converter={StaticResource SeverityBrush}}"
                                     Tag="{Binding BadgeSeverity, Converter={StaticResource SeverityIs}, ConverterParameter=Ok}" />
                            <TextBlock Text="{Binding BadgeText, Mode=OneWay}" FontWeight="SemiBold"
                                       Foreground="{Binding BadgeSeverity, Converter={StaticResource SeverityBrush}}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding Message, Mode=OneWay}" Style="{StaticResource Muted}" Margin="12,2,0,0" />
                </StackPanel>
                <StackPanel Visibility="{Binding HasTarget, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Loc dash.watchedChannel}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                        <TextBlock FontWeight="SemiBold">
                            <Hyperlink Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       CommandParameter="{Binding ChannelUrl}"><Run Text="{Binding ChannelName, Mode=OneWay}" /> ↗</Hyperlink>
                        </TextBlock>
                        <TextBlock Text="{loc:Loc dash.campaign}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CampaignName, Mode=OneWay}" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Margin="0,4,0,0" Visibility="{Binding DropName, Converter={StaticResource PresentToVis}}">
                        <Run Text="{loc:Loc dash.drop}" Foreground="{StaticResource MutedBrush}" /><Run Text="{Binding DropName, Mode=OneWay}" />
                    </TextBlock>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar views:Motion.AnimatedValue="{Binding Percent, Mode=OneWay}" Height="12" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding PercentText, Mode=OneWay}" FontWeight="SemiBold" FontSize="15" Margin="12,0,0,0" />
                    </Grid>
                    <WrapPanel Margin="0,8,0,0">
                        <TextBlock Margin="0,0,18,0"><Run Text="{loc:Loc dash.watched}" Foreground="{StaticResource MutedBrush}" /><Run Text="{Binding WatchedText, Mode=OneWay}" /></TextBlock>
                        <TextBlock Margin="0,0,18,0"><Run Text="{loc:Loc dash.required}" Foreground="{StaticResource MutedBrush}" /><Run Text="{Binding RequiredText, Mode=OneWay}" /></TextBlock>
                        <TextBlock Margin="0,0,18,0"><Run Text="{loc:Loc dash.remaining}" Foreground="{StaticResource MutedBrush}" /><Run Text="{Binding RemainingText, Mode=OneWay}" /></TextBlock>
                        <TextBlock Margin="0,0,18,0"><Run Text="{loc:Loc dash.finish}" Foreground="{StaticResource MutedBrush}" /><Run Text="{Binding FinishText, Mode=OneWay}" /></TextBlock>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0">
                        <Run Text="{loc:Loc dash.method}" /><Run Text="{Binding MethodText, Mode=OneWay}" /><Run Text="{loc:Loc dash.lastProgress}" /><Run Text="{Binding LastProgressText, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
                <!-- Yenileme aralıkları (ayrıntı: ipucu) -->
                <TextBlock Text="{Binding InfoText}" Style="{StaticResource Muted}" FontSize="11" Opacity="0.7" Margin="0,10,0,0" TextWrapping="Wrap"
                           ToolTip="{Binding InfoTooltip}" AutomationProperties.AutomationId="RefreshInfo" />
            </StackPanel>
        </Border>

        <!-- GENEL -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <views:Icon Style="{StaticResource SectionIcon}" Data="{StaticResource IconGlobe}" />
            <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Loc dash.generalTitle}" />
            <TextBlock Style="{StaticResource Muted}" Text="{Binding GeneralCountText}" Margin="10,0,0,0" VerticalAlignment="Center"
                       Visibility="{Binding GeneralCountText, Converter={StaticResource PresentToVis}}" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding GeneralCampaigns}" ItemTemplate="{StaticResource CampaignTemplate}" />
        <TextBlock Style="{StaticResource Muted}" Text="{loc:Loc dash.noGeneral}" Margin="2,0,0,8"
                   Visibility="{Binding HasGeneral, Converter={StaticResource InvBoolToVis}}" />

        <!-- YAYINCI -->
        <StackPanel Orientation="Horizontal" Margin="0,10,0,8">
            <views:Icon Style="{StaticResource SectionIcon}" Data="{StaticResource IconUser}" />
            <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Loc dash.streamerTitle}" />
            <TextBlock Style="{StaticResource Muted}" Text="{Binding StreamerCountText}" Margin="10,0,0,0" VerticalAlignment="Center"
                       Visibility="{Binding StreamerCountText, Converter={StaticResource PresentToVis}}" />
        </StackPanel>
        <TextBlock Style="{StaticResource Muted}" FontSize="11" Opacity="0.75" Margin="2,-2,0,8" TextWrapping="Wrap"
                   Text="{loc:Loc dash.orderHint}"
                   Visibility="{Binding HasStreamerOrderHint, Converter={StaticResource BoolToVis}}" />
        <ItemsControl ItemsSource="{Binding StreamerCards}" Margin="0,0,-10,0" Focusable="False" views:CardDrag.Enabled="True"
                      AutomationProperties.AutomationId="StreamerGrid">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="5" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <views:DropCard AutomationProperties.AutomationId="DropCard" AutomationProperties.Name="{Binding Name}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Style="{StaticResource Muted}" Text="{loc:Loc dash.noStreamer}" Margin="2,0,0,8"
                   Visibility="{Binding HasStreamer, Converter={StaticResource InvBoolToVis}}" />
        <TextBlock Text="{Binding TotalsText}" Style="{StaticResource Muted}" Margin="2,2,0,18"
                   Visibility="{Binding TotalsText, Converter={StaticResource PresentToVis}}" />
        <Border Height="14" Visibility="{Binding TotalsText, Converter={StaticResource AbsentToVis}}" />

        <!-- CLAIM EDİLEN ÖDÜLLER: sönük/pasif (hover'da canlanır); "… ve N ödül daha" başlığın yanında -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <views:Icon Style="{StaticResource SectionIcon}" Data="{StaticResource IconAward}" />
                <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Loc dash.claimedTitle}" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding ClaimedMoreText}" Style="{StaticResource Muted}" Opacity="0.7" Margin="10,0,0,0" VerticalAlignment="Center"
                       Visibility="{Binding ClaimedMoreText, Converter={StaticResource PresentToVis}}" />
        </Grid>
        <ItemsControl ItemsSource="{Binding ClaimedRewards}" Margin="0,0,-10,0" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="5" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <views:ClaimedCard />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{loc:Loc dash.noClaimed}" Style="{StaticResource Muted}" Margin="2,0,0,0"
                   Visibility="{Binding HasClaimed, Converter={StaticResource InvBoolToVis}}" />
        <Border Height="18" />

        <!-- SON OLAYLAR -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <views:Icon Style="{StaticResource SectionIcon}" Data="{StaticResource IconList}" />
            <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Loc dash.eventsTitle}" />
        </StackPanel>
        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Events}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding TimeText, Mode=OneWay}" Style="{StaticResource Muted}" />
                                <TextBlock Grid.Column="1" Text="{Binding Text, Mode=OneWay}" TextWrapping="Wrap"
                                           Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{loc:Loc dash.noEvents}" Style="{StaticResource Muted}"
                           Visibility="{Binding HasEvents, Converter={StaticResource InvBoolToVis}}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
