    <Style TargetType="views:Icon">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="views:Icon">
                    <Viewbox Stretch="Uniform">
                        <Canvas Width="24" Height="24">
                            <Path x:Name="Glyph" Data="{TemplateBinding Data}" Stroke="{TemplateBinding Foreground}" Fill="Transparent"
                                  StrokeThickness="{TemplateBinding StrokeThickness}" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Canvas>
                    </Viewbox>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFilled" Value="True">
                            <Setter TargetName="Glyph" Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Glyph" Property="StrokeThickness" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Güncelleme notları sayfası: geçmiş düğmesi ve bölüm ikonları (eklenen / değişen / düzeltilen / kaldırılan) -->
    <Geometry x:Key="IconHistory">M3,12 A9,9 0 1 0 6,5.3 L3,8 M3,3 V8 H8 M12,7 V12 L15,14</Geometry>
    <Geometry x:Key="IconPlusCircle">M12,2 A10,10 0 1 1 12,22 A10,10 0 1 1 12,2 Z M12,8 V16 M8,12 H16</Geometry>
    <Geometry x:Key="IconEdit">M12,20 H21 M16.5,3.5 A2.1,2.1 0 0 1 19.5,6.5 L7,19 L3,20 L4,16 Z</Geometry>
    <Geometry x:Key="IconMinusCircle">M12,2 A10,10 0 1 1 12,22 A10,10 0 1 1 12,2 Z M8,12 H16</Geometry>

    <!-- Bölüm başlığı ikonu: platform vurgusunda -->
    <Style x:Key="SectionIcon" TargetType="views:Icon" BasedOn="{StaticResource {x:Type views:Icon}}">
        <Setter Property="Foreground" Value="{DynamicResource PlatformAccentBrush}" />
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Margin" Value="2,0,8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Düğme içindeki ikon: düğmenin ön plan rengini izler -->
    <Style x:Key="BtnIcon" TargetType="views:Icon" BasedOn="{StaticResource {x:Type views:Icon}}">
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}" />
        <Setter Property="Margin" Value="0,0,7,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
