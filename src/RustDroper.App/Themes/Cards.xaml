<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:RustDroper.App.Views"
                    xmlns:loc="clr-namespace:RustDroper.App.Localization">
        <!-- Kopyala düğmesi: Tag=true iken ~2 sn "Kopyalandı" (tik ikonu ✓ + yeşil metin) -->
        <Style x:Key="CopyIcon" TargetType="views:Icon" BasedOn="{StaticResource BtnIcon}">
            <Setter Property="Data" Value="{StaticResource IconCopy}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Data" Value="{StaticResource IconCheck}" />
                    <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CopyLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CopiedLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
            <Setter Property="Text" Value="{loc:Loc cards.copied}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Platform kartı: sol şerit + marka işareti; seçili platformun kartı gösterilir (Twitch: cihaz kodu, Kick: QR + oynatıcı oturumu) -->
        <DataTemplate x:Key="PlatformCardTemplate">
            <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource PlatformAccentBrush}" />
                    <StackPanel Grid.Column="1" Margin="16,14,16,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" MinWidth="170" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource TrackBrush}" VerticalAlignment="Center">
                                <views:Icon IsFilled="True" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <views:Icon.Style>
                                        <Style TargetType="views:Icon" BasedOn="{StaticResource {x:Type views:Icon}}">
                                            <Setter Property="Data" Value="{StaticResource IconTwitch}" />
                                            <Setter Property="Foreground" Value="{StaticResource TwitchBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsKick}" Value="True">
                                                    <Setter Property="Data" Value="{StaticResource IconKick}" />
                                                    <Setter Property="Foreground" Value="{StaticResource KickBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </views:Icon.Style>
                                </views:Icon>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" />
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <Ellipse Width="8" Height="8" Margin="0,2,8,0" VerticalAlignment="Center" Style="{StaticResource PulseDot}"
                                             Fill="{Binding Severity, Converter={StaticResource SeverityBrush}}"
                                             Tag="{Binding Severity, Converter={StaticResource SeverityIs}, ConverterParameter=Info}" />
                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="520" />
                                </StackPanel>
                                <!-- Facepunch/Steam bağlantısı: giriş yapılmışsa "Bağlı" satırının altında (yeşil/kırmızı/gri daire) -->
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}"
                                            AutomationProperties.AutomationId="LinkStatusRow">
                                    <Ellipse Width="8" Height="8" Margin="0,2,8,0" VerticalAlignment="Center"
                                             Fill="{Binding DataContext.Dashboard.LinkSeverity, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SeverityBrush}}" />
                                    <TextBlock Text="{Binding DataContext.Dashboard.LinkStatusText, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Muted}" />
                                    <Button Style="{StaticResource GhostButton}" Margin="10,-3,0,-3" Padding="8,3" FontSize="11"
                                            Command="{Binding DataContext.Dashboard.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding DataContext.Dashboard.ConnectUrl, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Visibility="{Binding DataContext.Dashboard.CanConnect, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{loc:Loc cards.linkAccount}" Foreground="{StaticResource InfoBrush}" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                            <!-- Etkinlik bilgisi (kartın ortası): rozet + ad + "↗ Siteyi aç", ayrıntı, yerel tarihler, kalan süre (dakikada bir) -->
                            <StackPanel Grid.Column="2" Margin="24,0,24,0" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.AutomationId="EventInfo">
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                DataContext="{Binding DataContext.Dashboard.Event, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Visibility="{Binding HasEvent, Converter={StaticResource BoolToVis}}">
                                        <Border CornerRadius="9" Padding="8,1" Background="{StaticResource TrackBrush}" VerticalAlignment="Center"
                                                Visibility="{Binding StatusText, Converter={StaticResource PresentToVis}}">
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{Binding StatusSeverity, Converter={StaticResource SeverityBrush}}" />
                                        </Border>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="260" Visibility="{Binding HasTitle, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <!-- Platformun resmî drop sitesi (yalnız bu sabit adres; varsayılan tarayıcıda açılır) -->
                                    <Button Style="{StaticResource GhostButton}" Margin="8,-3,0,-3" Padding="7,3" VerticalAlignment="Center"
                                            Command="{Binding DataContext.Dashboard.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding SiteUrl}" ToolTip="{Binding SiteTooltip}"
                                            AutomationProperties.AutomationId="SiteButton">
                                        <StackPanel Orientation="Horizontal">
                                            <views:Icon Style="{StaticResource BtnIcon}" Data="{StaticResource IconExternal}" Width="12" Height="12" Margin="0,0,5,0" />
                                            <TextBlock Text="{loc:Loc cards.openSite}" FontSize="11" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel DataContext="{Binding DataContext.Dashboard.Event, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Visibility="{Binding HasEvent, Converter={StaticResource BoolToVis}}" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding DetailText}" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="360" HorizontalAlignment="Left"
                                               Visibility="{Binding DetailText, Converter={StaticResource PresentToVis}}" />
                                    <TextBlock Text="{Binding DatesText}" Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Left"
                                               Visibility="{Binding DatesText, Converter={StaticResource PresentToVis}}" />
                                    <TextBlock Text="{Binding CountdownText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InfoBrush}" HorizontalAlignment="Left"
                                               Visibility="{Binding CountdownText, Converter={StaticResource PresentToVis}}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding ActionCommand}" Visibility="{Binding ActionLabel, Converter={StaticResource PresentToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <views:Icon Style="{StaticResource BtnIcon}" Data="{Binding ActionIcon, Converter={StaticResource GeometryKey}}" />
                                        <TextBlock Text="{Binding ActionLabel}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <!-- Twitch cihaz kodu: büyük, ortalı; yanında/altında Kopyala (panoya yalnız kod) -->
                        <Border Background="{StaticResource TrackBrush}" CornerRadius="8" Padding="14,12" Margin="0,12,0,0"
                                Visibility="{Binding DeviceCode, Converter={StaticResource PresentToVis}}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{loc:Loc cards.enterCode}" Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,6">
                                    <TextBlock Text="{Binding DeviceCode}" FontFamily="Consolas" FontSize="34" FontWeight="Bold" VerticalAlignment="Center"
                                               AutomationProperties.AutomationId="DeviceCodeText" />
                                    <Button Command="{Binding CopyCodeCommand}" Tag="{Binding CodeCopied}" Padding="10,6" Margin="16,0,0,0" VerticalAlignment="Center"
                                            Visibility="{Binding CopyCodeCommand, Converter={StaticResource PresentToVis}}"
                                            AutomationProperties.AutomationId="CopyCodeButton" ToolTip="{loc:Loc cards.copyCode.tip}">
                                        <StackPanel Orientation="Horizontal">
                                            <views:Icon Style="{StaticResource CopyIcon}" />
                                            <TextBlock Text="{loc:Loc cards.copy}" Style="{StaticResource CopyLabel}" />
                                            <TextBlock Style="{StaticResource CopiedLabel}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock HorizontalAlignment="Center">
                                    <Hyperlink Command="{Binding DataContext.Dashboard.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                               CommandParameter="{Binding ActivateUrl}"><Run Text="{Binding LoginLinkText, Mode=OneWay}" /></Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <!-- Kick QR girişi: telefondaki Kick uygulamasıyla okutulur (bağlantı masaüstü tarayıcıda 404 verir); ortalı, aynı Kopyala düğmesi -->
                        <Border Background="{StaticResource TrackBrush}" CornerRadius="8" Padding="14,12" Margin="0,12,0,0"
                                Visibility="{Binding QrPng, Converter={StaticResource PresentToVis}}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{loc:Loc cards.qrInstruction}"
                                           Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520" />
                                <Border Background="White" Padding="6" HorizontalAlignment="Center" Margin="0,10,0,10" CornerRadius="6">
                                    <Image Source="{Binding QrPng, Converter={StaticResource BytesToImage}}" Width="190" Height="190"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                </Border>
                                <Button HorizontalAlignment="Center" Padding="12,6" Tag="{Binding LinkCopied}"
                                        Command="{Binding CopyLinkCommand}" CommandParameter="{Binding ActivateUrl}"
                                        AutomationProperties.AutomationId="CopyLinkButton"
                                        ToolTip="{loc:Loc cards.copyLink.tip}">
                                    <StackPanel Orientation="Horizontal">
                                        <views:Icon Style="{StaticResource CopyIcon}" />
                                        <TextBlock Text="{loc:Loc cards.copyLink}" Style="{StaticResource CopyLabel}" />
                                        <TextBlock Style="{StaticResource CopiedLabel}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                        <!-- Kick oynatıcı oturumu (gizli gerçek oynatıcının tarayıcı profili): giriş yalnızca kullanıcı tarafından, görünür pencerede yapılır -->
                        <Grid Margin="0,12,0,0" Visibility="{Binding PlayerSessionText, Converter={StaticResource PresentToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Margin="0,2,8,0" VerticalAlignment="Center"
                                         Fill="{Binding PlayerSessionSeverity, Converter={StaticResource SeverityBrush}}" />
                                <TextBlock Text="{Binding PlayerSessionText}" Style="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="400" />
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding PlayerLoginCommand}" Padding="10,5" Margin="8,0,0,0"
                                    ToolTip="{loc:Loc cards.playerLogin.tip}">
                                <StackPanel Orientation="Horizontal">
                                    <views:Icon Style="{StaticResource BtnIcon}" Data="{StaticResource IconLogIn}" />
                                    <TextBlock Text="{loc:Loc cards.playerLogin}" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Command="{Binding PlayerRefreshCommand}" Padding="9,5" Margin="6,0,0,0"
                                    ToolTip="{loc:Loc cards.playerRefresh.tip}">
                                <views:Icon Style="{StaticResource BtnIcon}" Data="{StaticResource IconRefresh}" Margin="0" />
                            </Button>
                        </Grid>
                        <TextBlock Text="{Binding Error}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Visibility="{Binding Error, Converter={StaticResource PresentToVis}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
</ResourceDictionary>
