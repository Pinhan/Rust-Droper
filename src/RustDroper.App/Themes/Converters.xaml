                    xmlns:views="clr-namespace:RustDroper.App.Views">
    <views:BoolToVisibilityConverter x:Key="BoolToVis" />
    <views:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />
    <views:NullToVisibilityConverter x:Key="PresentToVis" />
    <views:NullToVisibilityConverter x:Key="AbsentToVis" Invert="True" />
    <views:SeverityToBrushConverter x:Key="SeverityBrush" />
    <views:SeverityIsConverter x:Key="SeverityIs" />
    <views:GeometryKeyConverter x:Key="GeometryKey" />
    <views:DropStateConverter x:Key="StateIs" />
    <views:DropStateConverter x:Key="StateVis" AsVisibility="True" />
    <views:PathToImageConverter x:Key="PathToImage" />
    <views:BytesToImageConverter x:Key="BytesToImage" />
    <views:ScaleConverter x:Key="ScaleConverter" />
</ResourceDictionary>
